{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", ".astro/actions.d.ts", "**/*"],
  "exclude": ["dist", "__generated", "utils"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "target": "ES6", // @0no-co/graphqlsp Requires ES6 and above
    "plugins": [
      {
        "name": "@0no-co/graphqlsp",
        "schema": "./src/pages/tools/codegen/schema.graphql"
      }
    ]
  },
}
