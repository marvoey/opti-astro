---
import ToolsLayout from '../../layouts/ToolsLayout.astro';

export const prerender = false;
---

<ToolsLayout title="Test Page" description="Generic test page for development and debugging">
  <div class="min-h-screen p-6">
      <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="mb-8">
          <h1 class="text-3xl font-bold mb-2">Test Page</h1>
          <p class="text-base-content/70">Generic test page for development and debugging</p>
        </div>

        <!-- Main Content Area -->
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h2 class="card-title">Content Area</h2>
            <p>This is a generic test page. Add your test content here.</p>

            <!-- Example: Button Group -->
            <div class="card-actions justify-start mt-4">
              <button class="btn btn-primary">Primary</button>
              <button class="btn btn-secondary">Secondary</button>
              <button class="btn btn-accent">Accent</button>
              <button class="btn btn-ghost">Ghost</button>
            </div>

            <!-- Example: Alert -->
            <div class="alert alert-info mt-4">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>This is an example info alert component.</span>
            </div>

            <!-- Example: Form -->
            <div class="form-control w-full mt-4">
              <label class="label">
                <span class="label-text">Test Input</span>
              </label>
              <input type="text" placeholder="Type here" class="input input-bordered w-full" />
            </div>

            <!-- Example: Code Block -->
            <div class="mockup-code mt-4">
              <pre><code>console.log('Hello from test page!');</code></pre>
            </div>
          </div>
        </div>

        <!-- Additional Test Area -->
        <div class="card bg-base-100 shadow-xl mt-6">
          <div class="card-body">
            <h2 class="card-title">Additional Test Area</h2>
            <div id="testOutput" class="p-4 bg-base-200 rounded-lg">
              <p class="text-sm">Test output will appear here...</p>
            </div>
          </div>
        </div>
      </div>
  </div>

  <script>
    // Add your test JavaScript here
    console.log('Test page loaded');

    const testOutput = document.getElementById('testOutput');

    // Example: Update output
    if (testOutput) {
      testOutput.innerHTML = `
        <p class="text-sm font-semibold">Page loaded at: ${new Date().toLocaleString()}</p>
        <p class="text-sm mt-2">Ready for testing!</p>
      `;
    }
  </script>
</ToolsLayout>
