---
import type { Laptop } from '../../laptops/_data/laptops';
import type { FeaturedDeal } from '../../laptops/_data/featuredDeals';
import { FALLBACK_LAPTOP_IMG, FALLBACK_DEAL_IMG, FALLBACK_INFO_IMG } from '../../laptops/_data/helpers';

interface Props {
    laptops: Laptop[];
    featuredDeals: FeaturedDeal[];
    title?: string;
    subtitle?: string;
    totalResults?: number;
}

const {
    laptops,
    featuredDeals,
    title = 'Laptop Computers',
    subtitle = 'Compare the best Dell laptop models for home, school, business and gaming.',
    totalResults = 53,
} = Astro.props;
---

<div class="product-area">

    <!-- Header: title + toolbar -->
    <div class="product-area__header">
        <h1 class="product-area__title">{title}</h1>
        <p class="product-area__subtitle">{subtitle}</p>
        <div class="product-area__toolbar">
            <span class="product-area__count">
                Showing <strong>1–12</strong> of <strong>{totalResults}</strong> results
            </span>
            <div class="product-area__controls">
                <label style="font-size:13px;color:#555;" for="sort-sel">Sort by:</label>
                <select id="sort-sel" class="sort-select">
                    <option>Best Match</option>
                    <option>Price: Low to High</option>
                    <option>Price: High to Low</option>
                    <option>Newest First</option>
                    <option>Customer Rating</option>
                </select>
                <div style="display:flex;gap:4px;">
                    <button class="view-btn" title="Grid view" aria-label="Grid view">
                        <svg width="15" height="15" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                            <path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM11 13a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                        </svg>
                    </button>
                    <button class="view-btn" title="List view" aria-label="List view">
                        <svg width="15" height="15" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                            <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Product grid – first 4 -->
    <div class="product-grid">
        {laptops.slice(0, 4).map((laptop) => (
            <article class="product-card">
                {laptop.tag && (
                    <span
                        class="tag-badge"
                        style={
                            laptop.tag === 'Sale'        ? 'background:#cc0000;color:#fff;' :
                            laptop.tag === 'Best Seller' ? 'background:#0076ce;color:#fff;' :
                                                           'background:#444;color:#fff;'
                        }
                    >
                        {laptop.tag}
                    </span>
                )}
                <div class="product-card__compare">
                    <label class="compare-label">
                        <input type="checkbox" class="filter-checkbox" style="width:12px;height:12px;" />
                        Compare
                    </label>
                </div>
                <a href="#" class="product-card__img">
                    <img
                        src={laptop.image}
                        alt={laptop.name}
                        loading="lazy"
                        onerror={`this.onerror=null;this.src='${FALLBACK_LAPTOP_IMG}'`}
                    />
                </a>
                <a href="#" class="product-card__name">{laptop.name}</a>
                <div class="product-card__rating">
                    <span class="stars">
                        {Array.from({ length: 5 }).map((_, i) => (
                            <svg
                                class:list={[i < Math.floor(laptop.rating) ? "star-filled" : "star-empty"]}
                                width="12" height="12" fill="currentColor" viewBox="0 0 20 20"
                            >
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                            </svg>
                        ))}
                    </span>
                    <span class="rating-count">({laptop.reviews.toLocaleString()})</span>
                </div>
                <ul class="product-card__specs">
                    {laptop.specs.map((spec) => (
                        <li class="product-card__spec">
                            <span class="spec-dot">•</span>
                            <span>{spec}</span>
                        </li>
                    ))}
                </ul>
                <div class="product-card__price">
                    <div class="price-was">{laptop.wasPrice}</div>
                    <div class="price-now">{laptop.nowPrice}</div>
                </div>
                <button class="btn-dell">Add to Cart</button>
                <button class="btn-dell-outline">Customize &amp; Buy</button>
            </article>
        ))}
    </div>

    <!-- Recommended deals banner -->
    <section class="deals-banner" aria-label="Recommended deals">
        <div class="deals-banner__header">
            <h2 class="deals-banner__title">Recommended laptop deals</h2>
            <p class="deals-banner__subtitle">Limited time offers — save big on top picks</p>
        </div>
        <div class="deals-grid">
            {featuredDeals.map((deal) => (
                <article class="featured-card">
                    <a href="#" class="deal-card__img">
                        <img
                            src={deal.image}
                            alt={deal.name}
                            loading="lazy"
                            onerror={`this.onerror=null;this.src='${FALLBACK_DEAL_IMG}'`}
                        />
                    </a>
                    <a href="#" class="deal-card__name">{deal.name}</a>
                    <p class="deal-card__subtitle">{deal.subtitle}</p>
                    <ul class="deal-card__specs">
                        {deal.specs.map((spec) => (
                            <li style="display:flex;gap:5px;align-items:flex-start;">
                                <span style="color:#60a5fa;margin-top:1px;flex-shrink:0;">•</span>
                                <span>{spec}</span>
                            </li>
                        ))}
                    </ul>
                    <div class="product-card__price">
                        <div class="deal-card__was">{deal.wasPrice}</div>
                        <div class="deal-card__now">{deal.nowPrice}</div>
                    </div>
                    <button class="btn-dell">Add to Cart</button>
                </article>
            ))}
        </div>
        <p class="deals-banner__note">
            * Offer ends soon. While supplies last.&nbsp;
            <a href="#" style="color:#93c5fd;text-decoration:underline;">View all deals</a>
        </p>
    </section>

    <!-- Product grid – remaining -->
    <div class="product-grid">
        {laptops.slice(4).map((laptop) => (
            <article class="product-card">
                {laptop.tag && (
                    <span
                        class="tag-badge"
                        style={
                            laptop.tag === 'Gaming' ? 'background:#6d28d9;color:#fff;' :
                                                      'background:#444;color:#fff;'
                        }
                    >
                        {laptop.tag}
                    </span>
                )}
                <div class="product-card__compare">
                    <label class="compare-label">
                        <input type="checkbox" class="filter-checkbox" style="width:12px;height:12px;" />
                        Compare
                    </label>
                </div>
                <a href="#" class="product-card__img">
                    <img
                        src={laptop.image}
                        alt={laptop.name}
                        loading="lazy"
                        onerror={`this.onerror=null;this.src='${FALLBACK_LAPTOP_IMG}'`}
                    />
                </a>
                <a href="#" class="product-card__name">{laptop.name}</a>
                <div class="product-card__rating">
                    <span class="stars">
                        {Array.from({ length: 5 }).map((_, i) => (
                            <svg
                                class:list={[i < Math.floor(laptop.rating) ? "star-filled" : "star-empty"]}
                                width="12" height="12" fill="currentColor" viewBox="0 0 20 20"
                            >
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                            </svg>
                        ))}
                    </span>
                    <span class="rating-count">({laptop.reviews.toLocaleString()})</span>
                </div>
                <ul class="product-card__specs">
                    {laptop.specs.map((spec) => (
                        <li class="product-card__spec">
                            <span class="spec-dot">•</span>
                            <span>{spec}</span>
                        </li>
                    ))}
                </ul>
                <div class="product-card__price">
                    <div class="price-was">{laptop.wasPrice}</div>
                    <div class="price-now">{laptop.nowPrice}</div>
                </div>
                <button class="btn-dell">Add to Cart</button>
                <button class="btn-dell-outline">Customize &amp; Buy</button>
            </article>
        ))}
    </div>

    <!-- Pagination -->
    <div class="pagination">
        <button class="page-btn">&#8249; Prev</button>
        {[1, 2, 3, 4, 5].map((p) => (
            <button class:list={["page-btn", p === 1 && "page-btn--active"]}>{p}</button>
        ))}
        <button class="page-btn">Next &#8250;</button>
    </div>

    <!-- Windows 11 info box -->
    <section class="info-box" aria-label="Windows 11 information">
        <img
            class="info-box__img"
            src="https://i.dell.com/sites/csimages/Video_Imagery/all/inspiron-14-5445-laptop-pdp-mod01.png"
            alt="Dell laptop running Windows 11"
            loading="lazy"
            onerror={`this.onerror=null;this.src='${FALLBACK_INFO_IMG}'`}
        />
        <div>
            <h3 class="info-box__title">Windows 10 support has ended. Time to upgrade.</h3>
            <p class="info-box__body">
                Microsoft ended support for Windows 10 on October 14, 2025. All new Dell laptops
                come with Windows 11 pre-installed for enhanced security, performance, and AI-powered features.
            </p>
            <div class="info-box__links">
                <a href="#" class="info-link">Learn more about Windows 11 &rarr;</a>
                <a href="#" class="info-link">Shop Windows 11 Laptops &rarr;</a>
            </div>
        </div>
    </section>

    <!-- SEO copy -->
    <div class="seo-copy">
        <h2>About Dell Laptop Computers</h2>
        <p>
            Dell offers a comprehensive lineup of laptop computers designed to meet the needs of every user —
            from students and home users to enterprise professionals and hardcore gamers. Our laptops feature
            the latest Intel® Core™ Ultra and AMD Ryzen™ processors, paired with fast NVMe SSD storage and
            vibrant displays ranging from compact 13" ultrabooks to expansive 17" workstations.
        </p>
        <br />
        <p>
            The Inspiron series delivers reliable everyday performance at accessible price points. The XPS
            lineup provides premium build quality and stunning InfinityEdge displays for power users and
            creators. For business, the Latitude and Vostro lines offer enterprise-grade security and
            manageability. Alienware represents the pinnacle of Dell gaming with cutting-edge GPUs and
            high-refresh displays built for competitive play.
        </p>
    </div>

</div>
