---
import type { Locales } from 'astro';
import { getOptimizelySdk } from '../../../graphql/getSdk';
import { localeToSdkLocale } from '../../../lib/locale-helpers';
import Component from '../../../cms/components/_Component.astro';
import Experiences from '../../../cms/experiences/_Experiences.astro';
import Pages from '../../../cms/pages/_Pages.astro';

// Get the content_id from the URL path
const { content_id } = Astro.params;

// Get optional query parameters
const url = Astro.url;
const locale = url.searchParams.get('locale') || 'en';
const version = url.searchParams.get('version') || undefined;

// Convert locale to SDK format
const sdkLocale = localeToSdkLocale(locale);

// Placeholder data structure
const previewData = {
    key: content_id,
    loc: sdkLocale as Locales,
    ver: version,
};

// Fetch content from Optimizely CMS
let contentData = null;
let contentTypes: string[] = [];
let error = null;

try {
    const optiResponse = await getOptimizelySdk(previewData).contentById({
        key: previewData.key,
        loc: previewData.loc,
        ver: previewData.ver,
    });

    contentData = optiResponse?._Content?.item;
    contentTypes = contentData?._metadata?.types || [];
} catch (e) {
    error = e instanceof Error ? e.message : 'Unknown error';
}

const isComponentType = contentTypes.includes('_Component');
const isExperienceType = contentTypes.includes('_Experience');
const isPageType = contentTypes.includes('_Page') && !isExperienceType;
---

<!DOCTYPE html>
<html lang={locale}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>CMP Preview - {content_id}</title>
    </head>
    <body>
        {error && (
            <div class="error-container p-8 bg-red-50 border-l-4 border-red-500">
                <h1 class="text-2xl font-bold text-red-700">Error Loading Content</h1>
                <p class="mt-2 text-red-600">{error}</p>
                <div class="mt-4 text-sm text-gray-600">
                    <p><strong>Content ID:</strong> {content_id}</p>
                    <p><strong>Locale:</strong> {locale}</p>
                    {version && <p><strong>Version:</strong> {version}</p>}
                </div>
            </div>
        )}

        {!contentData && !error && (
            <div class="preview-container p-8 text-center">
                <h1 class="text-3xl font-bold mb-4">CMP Preview</h1>
                <p class="text-lg text-gray-600 mb-4">Loading content...</p>
                <div class="text-sm text-gray-500">
                    <p><strong>Content ID:</strong> {content_id}</p>
                    <p><strong>Locale:</strong> {locale}</p>
                    {version && <p><strong>Version:</strong> {version}</p>}
                </div>
            </div>
        )}

        {contentData && !error && (
            <>
                {!contentTypes.length && (
                    <div class="text-center p-8">
                        <h1 class="text-5xl">No content types found</h1>
                        <p class="mt-4 text-gray-600">Content ID: {content_id}</p>
                    </div>
                )}
                {isComponentType && <Component data={{ ...previewData, types: contentTypes }} />}
                {isExperienceType && <Experiences data={{ ...previewData, types: contentTypes }} />}
                {isPageType && <Pages data={{ ...previewData, types: contentTypes }} />}
            </>
        )}
    </body>
</html>

<style>
    body {
        margin: 0;
        padding: 0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
    }
</style>
