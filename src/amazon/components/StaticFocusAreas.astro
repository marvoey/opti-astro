<section class="Xioh5zujJVUa6csl8avQfQ== FseKqLeZdvqEU-PXAXpTSw== cznudC8a-qwId9G9zN6o6w=="><div class="TrA+d1iB0sZH8VdJk4hSUw=="><div class="_4UW+WBj4ti6UIfntFok0lQ== VcQZ8VyIZ-OwskDxcN0JXg=="><h2 class="hKBvnu3uvQuAsRfuNDMUuQ==">Focus areas</h2><div class="_7Mk5pWsFy4SLPH0qmBvnqg=="><div class="_18t0urRH5LLPlGJFAOv8WQ==" data-testid="textComponentDescription">To maximize your impact, focus on areas where you can drive the most change. Browse playbooks, case studies, and other resources to help you take action towards a more sustainable future.</div><div class="_7UjHBVD9a0dd9Br2XADnvw=="></div></div></div><div class="HZEYqBSP8+9Pj+vWJkvoXw=="><kat-card class="yQmU4EAkGkExnsISv339RA== Kl0R4BmG8oZ4BeQGC5QOFg=="><div class="yQmU4EAkGkExnsISv339RA== -MM906qstVtBMmRXHmIoxA=="><div class="NU2KPx33ngUpx1lzW29uTQ=="><h3 class="yQmU4EAkGkExnsISv339RA== +l2ltl4U1p5U8T5gvYtZPg==">Buildings</h3><span class="Knt8Mn5v5ZWEh2chRK5fxg== yQmU4EAkGkExnsISv339RA=="> Whether you lease, own, build, or operate real estate, decarbonizing your buildings can help reduce emissions for your business and customers. Find data-driven approaches to track, plan, and invest in strategies like avoiding fossil fuels, reducing energy consumption, and building with lower carbon materials. </span></div><img src="https://library.exchange.aboutamazon.com/locale/en-us/resource-type/image/variation/desktop/buildings-secondaryhero-1.jpeg" alt="Stairs in a corporate building" class="srbjgTS+TGDkakr3my7h+Q== yQmU4EAkGkExnsISv339RA==" style="object-position: center center;"></div><div class="yQmU4EAkGkExnsISv339RA== rNGHPSQ6LkJ5dUp7gTbPUA==" slot="footer"><a class="cBBp0ONkDstSWuqP2JmSvA== yQmU4EAkGkExnsISv339RA==" href="/focus-areas/buildings">Explore resources<span class="nGhq-x-dJ+-45UR7uHLG+Q==">about Buildings</span></a><button type="button" class="Js4GC7cB0-subip38bKr5g== yQmU4EAkGkExnsISv339RA== n9BnU8njKKPitn8lxE9YkA== _7CXANYxqW7qd2wdisHratw== tOV-FDSAFbMqKyrVCUChoQ== wtnjwFrHnrUqF-MpDbUWPg==" tabindex