---
interface Props {
  backgroundImage: string;
  headline: string;
  description: string;
  cardImageSrc: string;
  cardImageAlt: string;
  cardTitle: string;
  cardDescription: string;
  cardHref: string;
  scrollDownText?: string;
}

const {
  backgroundImage,
  headline,
  description,
  cardImageSrc,
  cardImageAlt,
  cardTitle,
  cardDescription,
  cardHref,
  scrollDownText = "Scroll down",
