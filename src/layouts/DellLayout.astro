---
/**
 * DellLayout.astro
 * Self-contained, high-fidelity Dell Technologies page layout.
 * Styles live in DellLayout.css (imported below).
 */
import './DellLayout.css';

interface Breadcrumb {
    label: string;
    href?: string;
}

interface Props {
    title?: string;
    description?: string;
    breadcrumbs?: Breadcrumb[];
    showPromoBanner?: boolean;
    showBreadcrumb?: boolean;
    showIntelBadge?: boolean;
}

const {
    title = 'Dell Technologies | Official Site',
    description = 'Shop Dell computers, laptops, monitors, and accessories.',
    breadcrumbs = [],
    showPromoBanner = true,
    showBreadcrumb = true,
    showIntelBadge = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap"
        rel="stylesheet"
    />
</head>

<body>

<!-- ════════════════════════════════════════════════
     HEADER
     ════════════════════════════════════════════════ -->
<header class="d-header">

    <!-- Top bar: logo + search + utility nav -->
    <div class="d-topbar">

        <!-- Dell Technologies Logo -->
        <a href="/" class="d-logo" aria-label="Dell Technologies – go to homepage">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1017 132" aria-label="Dell Technologies" role="img">
                <title>Dell Technologies</title>
                <path d="M1015 84.89c0-12.23-6.8-17.66-20.39-20.38-13.58-2.71-21.73-4.08-21.73-13.58 0-6.79 5.43-10.87 14.95-10.87 12.23 0 16.3 5.43 16.3 12.23l1.36 1.36h5.43l1.36-1.36c0-13.58-10.87-19.02-24.46-19.02-14.95 0-23.09 8.15-23.09 17.67 0 10.87 8.15 16.3 21.73 19.02 13.59 2.72 20.38 4.08 20.38 14.95 0 6.79-4.07 12.23-17.66 12.23-12.23 0-17.66-6.8-17.66-14.95l-1.36-1.36h-5.43l-1.36 1.36c0 12.23 9.51 21.74 25.81 21.74 17.66-.02 25.82-8.17 25.82-19.04m-58.42-13.58l1.35-1.36v-4.07c0-19.02-10.87-32.61-29.89-32.61s-29.89 13.59-29.89 32.61v2.71c0 19.02 9.51 35.32 31.25 35.32 19.02 0 25.81-12.23 27.17-20.38l-1.36-1.36h-5.43l-1.36 1.36c-2.72 8.15-8.15 13.59-19.02 13.59-17.67 0-23.1-16.3-23.1-24.45l1.36-1.36h48.92zm-8.15-6.8h-40.76l-1.36-1.36c0-9.51 5.43-23.09 21.74-23.09 16.3 0 21.74 13.58 21.74 23.09l-1.36 1.36zm-59.78 36.68V35.97l-1.36-1.36h-5.43l-1.36 1.36v65.22l1.36 1.36h5.43l1.36-1.36zm0-78.8v-8.15l-1.36-1.36h-5.43l-1.36 1.36v8.15l1.36 1.36h5.43l1.36-1.36zm-51.62 74.73c-13.59 0-21.74-9.51-21.74-28.53s8.15-28.53 21.74-28.53c13.58 0 21.73 9.51 21.73 28.53 0 19.01-8.15 28.53-21.73 28.53m21.73-4.08c0 17.66-4.08 31.25-20.38 31.25-12.23 0-16.3-5.43-17.66-12.23l-1.36-1.36h-5.43l-1.36 1.36c1.36 10.87 9.51 19.02 25.81 19.02 17.67 0 28.53-10.87 28.53-38.04V35.97l-1.36-1.36h-4.08l-1.36 1.36-1.36 8.16h-1.36c-2.71-5.43-9.51-10.87-21.74-10.87-19.02 0-28.53 14.95-28.53 35.33 0 20.37 9.51 35.32 28.53 35.32 12.23 0 19.02-5.43 21.74-10.87h1.37zm-88.3-52.98c13.58 0 23.09 10.87 23.09 28.53s-9.51 28.53-23.09 28.53c-13.59 0-23.1-10.87-23.1-28.53s9.51-28.53 23.1-28.53m0 63.85c17.66 0 31.24-12.23 31.24-35.32s-13.58-35.33-31.24-35.33c-17.67 0-31.25 12.23-31.25 35.33 0 23.09 13.59 35.32 31.25 35.32m-40.76-2.72V8.81l-1.36-1.36h-5.43l-1.36 1.36v92.39l1.36 1.36h5.43l1.36-1.37zm-48.9-61.13c13.58 0 23.09 10.87 23.09 28.53s-9.51 28.53-23.09 28.53c-13.59 0-23.1-10.87-23.1-28.53s9.51-28.53 23.1-28.53m0 63.85c17.66 0 31.25-12.23 31.25-35.32s-13.59-35.33-31.25-35.33-31.25 12.23-31.25 35.33c0 23.09 13.59 35.32 31.25 35.32m-39.4-2.72V60.43c0-17.66-9.51-27.17-24.45-27.17-9.51 0-17.67 4.08-21.74 10.87h-1.36l-1.35-8.16-1.36-1.36h-4.08l-1.36 1.36v65.22l1.36 1.36h5.44l1.35-1.36V64.51c0-14.95 6.8-24.45 21.74-24.45 10.87 0 17.66 6.79 17.66 20.37v40.76l1.36 1.36h5.43l1.36-1.36zm-69.29 0V60.43c0-17.66-9.51-27.17-24.45-27.17-9.51 0-17.66 4.08-21.74 10.87h-1.36V8.81l-1.36-1.36h-5.43l-1.36 1.36v92.39l1.36 1.36h5.43l1.36-1.36V64.51c0-14.95 6.8-24.45 21.74-24.45 10.87 0 17.66 6.79 17.66 20.37v40.76l1.36 1.36h5.44l1.35-1.36zm-116.83-32.6c0-19.02 9.51-28.53 23.09-28.53s19.02 8.15 20.37 16.3l1.36 1.36h5.44l1.36-1.36c-1.36-13.58-12.23-23.09-28.53-23.09-17.66 0-31.24 10.87-31.24 35.33 0 24.45 13.58 35.32 31.24 35.32 16.3 0 27.17-9.51 28.53-23.09l-1.36-1.36h-5.44l-1.36 1.36c-1.36 8.15-6.79 16.3-20.37 16.3-13.59-.01-23.09-9.53-23.09-28.54m-14.95 2.72l1.36-1.36v-4.07c0-19.02-10.87-32.61-29.9-32.61-19.01 0-29.89 13.59-29.89 32.61v2.71c0 19.02 9.51 35.32 31.25 35.32 19.02 0 25.81-12.23 27.17-20.38l-1.36-1.36h-5.43l-1.36 1.36c-2.71 8.15-8.15 13.59-19.02 13.59-17.66 0-23.09-16.3-23.09-24.45l1.36-1.36h48.91zm-8.15-6.8h-40.76l-1.36-1.36c0-9.51 5.43-23.09 21.73-23.09 16.31 0 21.74 13.58 21.74 23.09l-1.35 1.36zm-36.61-51.63V8.81l-1.36-1.36h-70.65l-1.36 1.36v4.08l1.36 1.36h29.89l1.36 1.36v85.59l1.36 1.36h5.43l1.36-1.36V15.6l1.36-1.36h29.89l1.36-1.36zM322.2 83.65v18.9h-61.35V7.45h21.6v76.2h39.75zm-283.65 18.9c22.13 0 40.73-15.12 46.03-35.58l53.8 42.03 53.77-42.01v35.56h61.35v-18.9h-39.75V7.45h-21.6v35.56L140.58 83.3l-11.53-9.01L153.73 55l26.88-21-15.34-12-51.58 40.3-11.53-9.01L153.73 13 138.38 1l-53.8 42.03c-5.3-20.46-23.9-35.58-46.03-35.58H0v95.1h38.55zM21.6 83.65v-57.3h16.95C52.88 26.35 64.5 39.18 64.5 55S52.88 83.65 38.55 83.65H21.6z"/>
            </svg>
        </a>

        <!-- Search bar -->
        <div class="d-search" role="search">
            <input
                type="search"
                class="d-search__input"
                placeholder="Search Dell"
                aria-label="Search Dell"
            />
            <button class="d-search__btn" aria-label="Submit search">
                <!-- Magnifying glass -->
                <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
            </button>
        </div>

        <!-- Utility navigation -->
        <nav class="d-util" aria-label="Utility">

            <!-- Sign In -->
            <a href="/sign-in" class="d-util__item">
                <svg class="icon" width="15" height="15" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
                <span>Sign In</span>
                <svg class="d-util__caret icon" viewBox="0 0 10 7" fill="none"
                     stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                     aria-hidden="true">
                    <path d="M1 1.5L5 5.5L9 1.5"/>
                </svg>
            </a>

            <!-- Contact Us -->
            <a href="/contactus" class="d-util__item">
                <svg class="icon" width="15" height="15" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.44A2 2 0 0 1 3.58 1.25h3a2 2 0 0 1 2 1.72c.128.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6 6l1.11-1.11a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <span>Contact Us</span>
            </a>

            <!-- Region / Language -->
            <a href="/locale" class="d-util__item">
                <svg class="icon" width="15" height="15" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="2" y1="12" x2="22" y2="12"/>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
                <span>US/EN</span>
                <svg class="d-util__caret icon" viewBox="0 0 10 7" fill="none"
                     stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                     aria-hidden="true">
                    <path d="M1 1.5L5 5.5L9 1.5"/>
                </svg>
            </a>

            <!-- Cart -->
            <a href="/cart" class="d-util__item">
                <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <path d="M16 10a4 4 0 0 1-8 0"/>
                </svg>
                <span>Cart</span>
                <svg class="d-util__caret icon" viewBox="0 0 10 7" fill="none"
                     stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                     aria-hidden="true">
                    <path d="M1 1.5L5 5.5L9 1.5"/>
                </svg>
            </a>

        </nav>
    </div>

    <!-- Main navigation -->
    <nav class="d-mainnav" aria-label="Main">
        <div class="d-mainnav__inner">
            <ul class="d-mainnav__list">
                <li>
                    <a href="/ai" class="d-mainnav__link">Artificial Intelligence</a>
                </li>
                <li>
                    <a href="/infrastructure" class="d-mainnav__link">
                        IT Infrastructure
                        <svg width="10" height="7" viewBox="0 0 10 7" fill="none"
                             stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                             aria-hidden="true">
                            <path d="M1 1.5L5 5.5L9 1.5"/>
                        </svg>
                    </a>
                </li>
                <li>
                    <a href="/computers" class="d-mainnav__link">
                        Computers &amp; Accessories
                        <svg width="10" height="7" viewBox="0 0 10 7" fill="none"
                             stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                             aria-hidden="true">
                            <path d="M1 1.5L5 5.5L9 1.5"/>
                        </svg>
                    </a>
                </li>
                <li>
                    <a href="/services" class="d-mainnav__link">
                        Services
                        <svg width="10" height="7" viewBox="0 0 10 7" fill="none"
                             stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                             aria-hidden="true">
                            <path d="M1 1.5L5 5.5L9 1.5"/>
                        </svg>
                    </a>
                </li>
                <li>
                    <a href="/support" class="d-mainnav__link">
                        Support
                        <svg width="10" height="7" viewBox="0 0 10 7" fill="none"
                             stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                             aria-hidden="true">
                            <path d="M1 1.5L5 5.5L9 1.5"/>
                        </svg>
                    </a>
                </li>
                <li>
                    <a href="/deals" class="d-mainnav__link">
                        Deals
                        <svg width="10" height="7" viewBox="0 0 10 7" fill="none"
                             stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                             aria-hidden="true">
                            <path d="M1 1.5L5 5.5L9 1.5"/>
                        </svg>
                    </a>
                </li>
                <li>
                    <a href="/financing" class="d-mainnav__link">
                        Financing
                        <svg width="10" height="7" viewBox="0 0 10 7" fill="none"
                             stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                             aria-hidden="true">
                            <path d="M1 1.5L5 5.5L9 1.5"/>
                        </svg>
                    </a>
                </li>
            </ul>

            <!-- Dell Premier for Business -->
            <a href="/premier" class="d-mainnav__premier">
                <div class="d-mainnav__premier-bar" aria-hidden="true"></div>
                <span>Dell Premier for Business</span>
            </a>
        </div>
    </nav>

</header>

<!-- ════════════════════════════════════════════════
     PROMO BANNER
     ════════════════════════════════════════════════ -->
{showPromoBanner && (
    <aside class="d-promo" aria-label="Promotional offer">
        <div class="d-promo__inner">
            <!-- Laptop illustration -->
            <svg width="52" height="40" viewBox="0 0 52 40" fill="none"
                 xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <!-- Screen bezel -->
                <rect x="7" y="1" width="37" height="26" rx="2" fill="#d8d8d8" stroke="#b8b8b8" stroke-width="0.8"/>
                <!-- Display -->
                <rect x="9" y="3" width="33" height="22" rx="1" fill="#6ab0f5"/>
                <!-- Laptop body shine -->
                <rect x="7" y="3" width="4" height="22" rx="1" fill="white" opacity="0.2"/>
                <!-- Keyboard base -->
                <rect x="1" y="27" width="50" height="4" rx="1.5" fill="#c8c8c8"/>
                <!-- Trackpad -->
                <rect x="17" y="29" width="18" height="1.5" rx="0.75" fill="#b0b0b0"/>
            </svg>

            <p class="d-promo__text">
                Save big with limited time deals up to $800 off on PCs, accessories, and more.&nbsp;
                <a href="/deals" class="d-promo__link">View the Deals</a>
                &nbsp;|&nbsp;
                <a href="/support/contact" class="d-promo__link">
                    Questions? Call 1-877-275-3355 or Click to Chat
                </a>
            </p>
        </div>
    </aside>
)}

<!-- ════════════════════════════════════════════════
     BREADCRUMB BAR
     ════════════════════════════════════════════════ -->
{showBreadcrumb && (
    <div class="d-breadbar">
        <div class="d-breadbar__inner">

            <!-- Breadcrumbs -->
            <nav class="d-breadcrumb" aria-label="Breadcrumb">
                <a href="/" class="d-breadcrumb__home" aria-label="Home">
                    <svg class="icon" width="14" height="14" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                </a>
                {breadcrumbs.map((crumb, i) => (
                    <>
                        <span class="d-breadcrumb__sep" aria-hidden="true">/</span>
                        {crumb.href
                            ? <a href={crumb.href} class="d-breadcrumb__crumb">{crumb.label}</a>
                            : <span class="d-breadcrumb__crumb" aria-current="page">{crumb.label}</span>
                        }
                    </>
                ))}
            </nav>

            <!-- Right: Windows 11 + Intel -->
            <div class="d-breadbar__right">

                <!-- Windows 11 CTA -->
                <button class="d-win11-btn" type="button">
                    <!-- Windows logo grid -->
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="white"
                         aria-hidden="true">
                        <rect x="2" y="2" width="9" height="9" rx="0.5"/>
                        <rect x="13" y="2" width="9" height="9" rx="0.5"/>
                        <rect x="2" y="13" width="9" height="9" rx="0.5"/>
                        <rect x="13" y="13" width="9" height="9" rx="0.5"/>
                    </svg>
                    Get to know Windows&nbsp;11 devices
                </button>

                {showIntelBadge && (
                    <div class="d-intel">
                        <!-- Three Intel Core Ultra badges -->
                        <div class="d-intel__badges" aria-label="Intel Core Ultra processor tiers">
                            {[5, 7, 9].map((tier) => (
                                <div class="d-intel__badge" title={`Intel Core Ultra ${tier}`}>
                                    <span class="d-intel__badge-logo">intel</span>
                                    <span class="d-intel__badge-core">CORE</span>
                                    <span class="d-intel__badge-ultra">ULTRA</span>
                                    <span class="d-intel__badge-num">{tier}</span>
                                </div>
                            ))}
                        </div>
                        <div class="d-intel__links">
                            <a href="/intel-core-ultra" class="d-intel__link">
                                Intel® Core™ Ultra Processors
                            </a>
                            <a href="/intel-core-ultra/learn" class="d-intel__link">
                                Learn More about Intel
                            </a>
                        </div>
                    </div>
                )}

            </div>
        </div>
    </div>
)}

<!-- ════════════════════════════════════════════════
     MAIN CONTENT
     ════════════════════════════════════════════════ -->
<main class="d-main" id="main-content">
    <slot />
</main>

<!-- ════════════════════════════════════════════════
     FOOTER
     ════════════════════════════════════════════════ -->
<footer class="d-footer">

    <!-- Category links row -->
    <div class="d-footer__top">
        <a href="/dell-technologies" class="d-footer__cat">Dell Technologies</a>
        <a href="/premier" class="d-footer__cat">Dell Premier for Business</a>
        <a href="/financial-services" class="d-footer__cat">Dell Financial Services</a>
    </div>

    <!-- Legal / copyright row -->
    <div class="d-footer__legal">
        <div class="d-footer__legal-inner">
            <span class="d-footer__legal-item">Copyright &copy; 2026 Dell Inc.</span>

            <span class="d-footer__legal-sep" aria-hidden="true">|</span>
            <a href="/legal/terms-of-sale" class="d-footer__legal-item">Terms of Sale</a>

            <span class="d-footer__legal-sep" aria-hidden="true">|</span>
            <a href="/legal/privacy-statement" class="d-footer__legal-item">Privacy Statement</a>

            <span class="d-footer__legal-sep" aria-hidden="true">|</span>
            <a href="/legal/privacy-ccpa" class="d-footer__legal-item">
                Do Not Sell or Share My Personal Information
            </a>

            <span class="d-footer__legal-sep" aria-hidden="true">|</span>
            <a href="/legal/cookies" class="d-footer__legal-item">Cookies, Ads &amp; Emails</a>

            <span class="d-footer__legal-sep" aria-hidden="true">|</span>
            <a href="/legal/regulatory" class="d-footer__legal-item">Legal &amp; Regulatory</a>

            <span class="d-footer__legal-sep" aria-hidden="true">|</span>
            <a href="/accessibility" class="d-footer__legal-item">Accessibility</a>

            <span class="d-footer__legal-sep" aria-hidden="true">|</span>
            <a href="/legal/human-trafficking" class="d-footer__legal-item">
                Anti-Slavery, Human Trafficking &amp; Child Labor
            </a>
        </div>
    </div>

</footer>

</body>
</html>
